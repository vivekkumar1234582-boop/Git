pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/vivekkumar1234582-boop/hello-world.git'
            }
        }

        stage('Gitleaks Secret Scan') {
            steps {
                sh '''
                    set +e

                    docker run --rm \
                      -v "$WORKSPACE:/path" \
                      zricethezav/gitleaks:latest \
                      detect \
                      --source=/path \
                      --no-git \
                      --redact \
                      --report-format=json \
                      --report-path=/path/gitleaks-report.json \
                      --exit-code=1

                    RESULT=$?
                    echo "$RESULT" > gitleaks-exit-code.txt

                    exit 0
                '''
            }
        }

        stage('Gitleaks Report') {
            steps {
                script {
                    if (fileExists('gitleaks-report.json')) {
                        sh 'cat gitleaks-report.json'

                        archiveArtifacts(
                            artifacts: 'gitleaks-report.json',
                            allowEmptyArchive: false
                        )
                    } else {
                        error 'Gitleaks report was not generated!'
                    }

                    def scanResult = readFile(
                        'gitleaks-exit-code.txt'
                    ).trim()

                    if (scanResult != '0') {
                        error 'Gitleaks detected potential secrets. Check the archived report.'
                    }

                    echo 'Gitleaks scan passed. No leaks detected.'
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'gitleaks-report.json,gitleaks-exit-code.txt',
                allowEmptyArchive: true
            )
        }
    }
}
